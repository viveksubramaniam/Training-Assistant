.average_speed || 0) > 0;\n        });\n        if (fiveKs.length === 0) return '\u2014';\n        // Best pace = highest average_speed\n        const best = fiveKs.reduce((b, a) => a.average_speed > b.average_speed ? a : b, fiveKs[0]);\n        const paceMin = 16.6667 / best.average_speed;\n        const mins = Math.floor(paceMin);\n        const secs = Math.round((paceMin - mins) * 60);\n        return `${mins}:${secs.toString().padStart(2, '0')}`;\n    })", "source_file": "/home/vivek/project/ai_workout_planner/run-coach-app/frontend/src/ProfilePage.jsx", "source_location": "L194"}, {"caller_nid": "profilepage_profilepage", "callee": "indexOf", "source_file": "/home/vivek/project/ai_workout_planner/run-coach-app/frontend/src/ProfilePage.jsx", "source_location": "L210"}, {"caller_nid": "profilepage_profilepage", "callee": "toUpperCase", "source_file": "/home/vivek/project/ai_workout_planner/run-coach-app/frontend/src/ProfilePage.jsx", "source_location": "L296"}, {"caller_nid": "profilepage_profilepage", "callee": "formatDaysUntil", "source_file": "/home/vivek/project/ai_workout_planner/run-coach-app/frontend/src/ProfilePage.jsx", "source_location": "L302"}, {"caller_nid": "profilepage_profilepage", "callee": "map", "source_file": "/home/vivek/project/ai_workout_planner/run-coach-app/frontend/src/ProfilePage.jsx", "source_location": "L318"}, {"caller_nid": "profilepage_profilepage", "callee": "map", "source_file": "/home/vivek/project/ai_workout_planner/run-coach-app/frontend/src/ProfilePage.jsx", "source_location": "L358"}, {"caller_nid": "profilepage_profilepage", "callee": "toFixed", "source_file": "/home/vivek/project/ai_workout_planner/run-coach-app/frontend/src/ProfilePage.jsx", "source_location": "L400"}, {"caller_nid": "profilepage_profilepage", "callee": "toFixed", "source_file": "/home/vivek/project/ai_workout_planner/run-coach-app/frontend/src/ProfilePage.jsx", "source_location": "L626"}]}