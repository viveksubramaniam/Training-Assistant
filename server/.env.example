# Run Coach App - Server Environment Variables
# Copy this file to .env and fill in your values

# Strava OAuth credentials
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Session secret (generate a random string)
SESSION_SECRET=your-session-secret-here

# Database configuration
# Options: 'json' (default, uses local JSON files) or 'postgres' (Supabase/PostgreSQL)
DATABASE_TYPE=json

# PostgreSQL connection string (required if DATABASE_TYPE=postgres)
# Get this from Supabase: Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
